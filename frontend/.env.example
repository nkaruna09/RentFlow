# Copy to .env.local and fill in. Never commit .env.local.

# Base URL of the FastAPI backend
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Public site URL, used for absolute links and auth callbacks
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Session signing secret — generate with: openssl rand -base64 32
AUTH_SECRET=

# Azure Entra ID (only if Entra is chosen as the identity provider)
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=
AZURE_AD_TENANT_ID=
