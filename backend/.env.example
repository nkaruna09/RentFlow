# Copy to .env and fill in. Never commit .env.

ENVIRONMENT=local            # local | staging | production
DEBUG=true
LOG_LEVEL=INFO

# ---------- Database ----------
DATABASE_URL=postgresql+asyncpg://rentflow:rentflow@db:5432/rentflow

# ---------- Auth ----------
# Generate with: openssl rand -hex 32
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256

# ---------- CORS ----------
BACKEND_CORS_ORIGINS=["http://localhost:3000"]

# ---------- Azure ----------
# Locally, documents go to the Azurite emulator from docker-compose (well-known dev key).
# In Azure, leave the connection string empty: AZURE_STORAGE_ACCOUNT_URL + the
# managed identity (AZURE_CLIENT_ID) are used instead, and shared keys are disabled.
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==;BlobEndpoint=http://azurite:10000/devstoreaccount1;
AZURE_STORAGE_ACCOUNT_URL=
AZURE_STORAGE_CONTAINER=rentflow-documents
AZURE_CLIENT_ID=
AZURE_KEY_VAULT_URL=
APPLICATIONINSIGHTS_CONNECTION_STRING=

# ---------- Notifications ----------
AZURE_COMMUNICATION_CONNECTION_STRING=
NOTIFICATION_FROM_EMAIL=
